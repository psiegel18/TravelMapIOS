// travel.psiegel.org — Travel Mapping iOS landing page + privacy policy.
// Static assets only (no Worker script): `npx wrangler deploy` uploads docs/.
// GitHub Pages still serves the same files at psiegel18.github.io/TravelMapIOS/
// (the privacy URL App Store Connect points at).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-mapping-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "travel.psiegel.org", "custom_domain": true }
  ],
  "workers_dev": false
}
